# Neovim image — Fedora + dsedgmen/devenv COPR RPMs (configs/helpers from packages).
ARG FEDORA_VERSION=45
FROM registry.fedoraproject.org/fedora:${FEDORA_VERSION}

LABEL maintainer="devenv-packager"
LABEL org.opencontainers.image.title="devenv neovim"
LABEL description="Neovim with devenv COPR packages and Fedora LSP RPMs"

ARG FEDORA_VERSION=45

RUN dnf install -y dnf-plugins-core \
    && dnf copr enable -y dsedgmen/devenv \
    && dnf install -y \
        neovim \
        devenv-ai-assistant \
        devenv-ai-helper \
        devenv-lsp-setup \
        devenv-code-flowchart \
        devenv-image-inspect \
        python3-lsp-server \
        gopls \
        nodejs-bash-language-server \
        rust-analyzer \
        clang-tools-extra \
        tree-sitter-cli \
        libtree-sitter \
        libtree-sitter-python \
        libtree-sitter-bash \
        libtree-sitter-c \
        libtree-sitter-cpp \
        libtree-sitter-go \
        libtree-sitter-javascript \
        libtree-sitter-typescript \
        libtree-sitter-json \
        libtree-sitter-yaml \
        libtree-sitter-html \
        libtree-sitter-css \
        libtree-sitter-lua \
        libtree-sitter-rust \
        libtree-sitter-java \
        libtree-sitter-ruby \
        vim-fugitive \
        vim-gitgutter \
        vim-nerdtree \
        vim-ctrlp \
        vim-commentary \
        vim-rhubarb \
        vim-powerline \
        git \
        python3 \
        python3-google-genai \
        curl \
    && dnf clean all

ARG USER_UID=1000
ARG USER_GID=1000
ARG USERNAME=vimuser

RUN groupadd -g ${USER_GID} ${USERNAME} && \
    useradd -m -u ${USER_UID} -g ${USER_GID} -s /bin/bash ${USERNAME}

USER ${USERNAME}
WORKDIR /workspace

# COPR packages install under /usr/share/devenv-*; load them without staging configs.
ENV LUA_PATH="/usr/share/devenv-lsp-setup/?.lua;/usr/share/devenv-lsp-setup/?/init.lua;/usr/share/devenv-code-flowchart/?.lua;/usr/share/devenv-image-inspect/lua/?.lua;;"
ENV DEVENV_AI_BACKEND=ollama
ENV EDITOR=nvim

VOLUME ["/workspace"]

ENTRYPOINT ["nvim", "-u", "/usr/share/devenv-ai-assistant/nvim-init.lua"]
CMD []
